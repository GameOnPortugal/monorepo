# >>>> GLOBAL >>>>
DISCORD_TOKEN=1234567890
DISCORD_CLIENT_ID=your-client-id
# Dev-only: register slash commands to this guild instead of globally, so
# they appear instantly instead of taking up to an hour to propagate (M4.3).
# Leave unset for global registration (what production does). Deliberately
# NOT the same variable as DISCORD_GUILD_ID below, which is the production
# guild and defaults to it on its own — see
# src/Domain/Bot/CommandRegistration.ts for why reusing it would be unsafe.
# DISCORD_DEV_GUILD_ID=your-test-server-id
# <<<< GLOBAL <<<<

# >>>> DATABASE >>>>>
# Host must match the `mariadb` service name in docker-compose.yml / docker-compose.ci.yml.
DATABASE_URL=mysql://root:rootpassword@mariadb:3306/discord_bot
# <<<< DATABASE <<<<<

# >>>> DISCORD IDS (optional) >>>>
# Overrides for the hardcoded Discord snowflake defaults in
# src/Infrastructure/Community/Discord/DiscordChannels.ts. Leave unset to use
# the verified production values (the Game On Portugal guild, #screenshots,
# #anuncios, #server-log). A channel/guild move only needs these redeployed,
# not the code.
# DISCORD_GUILD_ID=818108848492773377
# DISCORD_CHANNEL_SCREENSHOTS=827646847483904040
# DISCORD_CHANNEL_MARKETPLACE=818447274266591243
# DISCORD_CHANNEL_ADMIN=818108848492773380
#
# TROPHIES has no verified default (M7.8) — unlike the three above, nobody
# has confirmed a channel for trophy announcements yet, so this is
# unconfigured out of the box and posting to it fails loudly until it is
# set. Required before TROPHIES_ANNOUNCE_ENABLED below does anything visible.
# DISCORD_CHANNEL_TROPHIES=
# <<<< DISCORD IDS <<<<

# >>>> JOB RUNNER (optional) >>>>
# The in-process job scheduler (M6.1). Leave unset for the defaults below.
# DISCORD_CHANNEL_ADMIN above is where M6.4's supervised dry runs and M6.8's
# per-run job summaries are posted — #server-log by default.
# JOB_TICK_INTERVAL_MS=60000
# JOB_WORK_LIMIT=200
#
# trophies:sync (M7.3) is bound and runnable by hand regardless of this
# setting (`bun run:command jobs:run trophies:sync --dry-run`), but is only
# added to the every-10-minutes schedule when this is "true". Off by
# default: merging to main deploys, and this job writes trophy rows and can
# set isBanned/isExcluded on real members — the first run needs to be a
# reviewed decision (dry-run, read the report), not a side effect of a
# merge. See TrophiesSyncJob.ts's doc comment for the full runbook.
# TROPHIES_SYNC_ENABLED=false
#
# Manual full-rescan override for one profile (see TrophiesSyncJob.ts) —
# only meaningful for a single `bun run:command jobs:run trophies:sync`
# invocation, never set persistently.
# TROPHIES_SYNC_ALL=false
# TROPHIES_SYNC_PROFILE=
#
# M7.8: announce each newly-credited trophy through GuildClient, to the
# channel configured above as DISCORD_CHANNEL_TROPHIES — replaces the old
# bot's TROPHY_WEBHOOK. Off by default, same reasoning as
# TROPHIES_SYNC_ENABLED: a merge to main deploys, so a feature that posts to
# a public channel needs to be an operator's opt-in, not a side effect of
# landing a PR. Even once enabled, a single profile's backlog collapses into
# one summary message above TrophiesSyncJob.ts's
# TROPHIES_ANNOUNCE_BATCH_THRESHOLD, and the whole run is capped at
# TROPHIES_ANNOUNCE_MAX_MESSAGES_PER_RUN messages — see that file's
# "Announcements, and their flood guard" doc comment.
# TROPHIES_ANNOUNCE_ENABLED=false
# <<<< JOB RUNNER <<<<

# >>>> OBJECT STORAGE / S3 (optional) >>>>
# Mirrors the MinIO service the production Portainer stack runs
# (infrastructure/game-on-portugal.yaml) for re-hosted screenshots and
# marketplace photos. Consumed by TYPES.MediaStorage (M6.0,
# src/Infrastructure/DependencyInjection/inversify.config.ts) — leave unset
# to bind InMemoryMediaStorage instead, which is what you want for local dev
# and tests unless you're specifically working on the storage adapter.
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_URL=https://media.game-on-portugal.pt
# S3_BUCKET=gop-media
# S3_ACCESS_KEY=gameonportugal
# S3_SECRET_KEY=changeme
# S3_REGION=us-east-1
# <<<< OBJECT STORAGE / S3 <<<<

# >>>> LOGGING (optional) >>>>
# Ships logs to a Grafana Loki instance in addition to stdout. Leave both
# unset to log to stdout only (the default, and what you want locally).
#
# M0.7 (docker/entrypoint.sh no longer prints the DATABASE_URL password to
# stdout, docs/known-issues.md #11) merged in PR #11 before this PR, so it is
# safe to set LOKI_HOST/LOKI_AUTH here. Still optional — leave unset locally.
# LOKI_HOST=
# LOKI_AUTH=
# <<<< LOGGING <<<<
