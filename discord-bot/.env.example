# >>>> GLOBAL >>>>
DISCORD_TOKEN=1234567890
DISCORD_CLIENT_ID=your-client-id
# Dev-only: register slash commands to this guild instead of globally, so
# they appear instantly instead of taking up to an hour to propagate (M4.3).
# Leave unset for global registration (what production does). Deliberately
# NOT the same variable as DISCORD_GUILD_ID below, which is the production
# guild and defaults to it on its own — see
# src/Domain/Bot/CommandRegistration.ts for why reusing it would be unsafe.
# DISCORD_DEV_GUILD_ID=your-test-server-id
# <<<< GLOBAL <<<<

# >>>> DATABASE >>>>>
# Host must match the `mariadb` service name in docker-compose.yml / docker-compose.ci.yml.
DATABASE_URL=mysql://root:rootpassword@mariadb:3306/discord_bot
# <<<< DATABASE <<<<<

# >>>> DISCORD IDS (optional) >>>>
# Overrides for the hardcoded Discord snowflake defaults in
# src/Infrastructure/Community/Discord/DiscordChannels.ts. Leave unset to use
# the verified production values (the Game On Portugal guild, #screenshots,
# #anuncios). A channel/guild move only needs these redeployed, not the code.
# DISCORD_GUILD_ID=818108848492773377
# DISCORD_CHANNEL_SCREENSHOTS=827646847483904040
# DISCORD_CHANNEL_MARKETPLACE=818447274266591243
# <<<< DISCORD IDS <<<<

# >>>> OBJECT STORAGE / S3 (optional) >>>>
# Mirrors the MinIO service the production Portainer stack runs
# (infrastructure/game-on-portugal.yaml) for re-hosted screenshots and
# marketplace photos. Consumed by TYPES.MediaStorage (M6.0,
# src/Infrastructure/DependencyInjection/inversify.config.ts) — leave unset
# to bind InMemoryMediaStorage instead, which is what you want for local dev
# and tests unless you're specifically working on the storage adapter.
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_URL=https://media.game-on-portugal.pt
# S3_BUCKET=gop-media
# S3_ACCESS_KEY=gameonportugal
# S3_SECRET_KEY=changeme
# S3_REGION=us-east-1
# <<<< OBJECT STORAGE / S3 <<<<

# >>>> LOGGING (optional) >>>>
# Ships logs to a Grafana Loki instance in addition to stdout. Leave both
# unset to log to stdout only (the default, and what you want locally).
#
# M0.7 (docker/entrypoint.sh no longer prints the DATABASE_URL password to
# stdout, docs/known-issues.md #11) merged in PR #11 before this PR, so it is
# safe to set LOKI_HOST/LOKI_AUTH here. Still optional — leave unset locally.
# LOKI_HOST=
# LOKI_AUTH=
# <<<< LOGGING <<<<
