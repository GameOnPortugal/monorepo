generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "mysql"
}

// Ad model (migrated from Sequelize)
model Ad {
  id          String   @id @default(uuid())
  name        String?
  author_id   String?
  channel_id  String?
  message_id  String?
  // Nullable to match the migrations and production. `schema.prisma` had these
  // as NOT NULL while 20250416170150_init created them nullable and nothing
  // since changed them — so `prisma db push` (tests) and `prisma migrate deploy`
  // (production) produced different shapes. The legacy Sequelize model had all
  // three nullable, so the migrations are right. See docs/known-issues.md #1.
  state       String?
  price       String?
  zone        String?
  dispatch    String?
  warranty    String?
  description String?  @db.Text
  // Historically 'sell' | 'sale' | 'wanted' — 'sale' and 'sell' meant the same
  // thing to two different authors. Normalised to 'sell' | 'wanted' by
  // migration 20260820000000_ad_lifecycle. See docs/known-issues.md #22.
  adType      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Ad lifecycle (M5.3). One of 'active' | 'sold' | 'expired' | 'deleted'.
  // Existing rows backfilled to 'active'. Kept a plain string, like adType,
  // rather than a DB enum — validity is enforced by the domain's AdStatus VO,
  // matching how the rest of this legacy table is unvalidated at the DB level.
  //
  // These seven columns are declared after createdAt/updatedAt (rather than
  // grouped with the fields they conceptually belong with, above) so their
  // declaration order matches the physical column order the migration's
  // `ALTER TABLE ... ADD COLUMN` produces — MariaDB always appends new
  // columns at the end. Reordering fields here without a matching migration
  // would make `prisma migrate diff` report phantom drift on every one of
  // them, since it compares by ordinal position.
  status      String    @default("active")
  // Parsed from the free-text `price` column where unambiguous (see the M5.3
  // migration for the exact rule). NULL means "could not parse", not "free".
  price_cents Int?
  // Durable, re-hosted image URLs (never Discord CDN links — cross-cutting
  // rule 3). JSON-encoded array of strings, NULL for every pre-M5.3 row since
  // none of the legacy ads have images at all.
  //
  // Plain `@db.Text` rather than Prisma's `Json` type: MariaDB has no native
  // JSON type — `JSON` is just an alias for `LONGTEXT CHECK (json_valid())` —
  // and `prisma migrate diff` does not recognise that shape as satisfying a
  // `Json`-typed field on this provider, so it reports permanent phantom
  // drift no migration can fix. A `Text` column storing JSON, encoded/decoded
  // in the Domain layer (`Ad.fromArray` / `OrmAdRepository`), stores exactly
  // the same bytes without the tooling mismatch — the same trade-off this
  // table already makes for `description`.
  images      String?   @db.Text
  bumped_at   DateTime?
  expires_at  DateTime?
  sold_at     DateTime?
  deleted_at  DateTime?

  // Lifecycle sweep: "every active ad whose expiry has passed".
  @@index([status, expires_at])
  // Idle-bump sweep and default listing sort (most recently bumped first).
  @@index([status, bumped_at])
  // "my active ads" / the 10-active-ads-per-user limit.
  @@index([author_id, status])
  // search() (M5.9) filtering by type within a status, newest first.
  @@index([status, adType, createdAt])
  @@map("ads")
}

// LFG (4 models), StockUrls, SpecialChannel and CommandChannelLink were
// removed here (M9.2/M9.3/M9.4/M9.6) — all seven tables held 0 rows in
// production. LFG will not be ported (Luis, 2026-08-19/2026-08-20, closed to
// discussion); stock alerts, the special-channel message validator and the
// command→channel link table are dropped outright — see
// docs/plans/GLOBAL-PLAN.md M9.2/M9.3/M9.4 and the "Standing instructions
// from Luis" section. Dropped in migration 20260820102655_drop_dead_models.

model Screenshot {
  id         String   @id @default(uuid())
  name       String?
  author_id  String?
  channel_id String?
  message_id String?
  plataform  String?
  image      String?  @db.Text
  image_md5  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("screenshots")
}

model TrophyProfile {
  id         String     @id @default(uuid())
  userId     String?
  psnProfile String?
  isBanned   Boolean?   @default(false)
  hasLeft    Boolean?   @default(false)
  isExcluded Boolean?   @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  trophies   Trophies[]

  @@map("trophyprofiles")
}

model Trophies {
  id             String         @id @default(uuid())
  trophyProfile  String?
  url            String?        @db.Text
  points         Int?
  completionDate DateTime?
  profile        TrophyProfile? @relation(fields: [trophyProfile], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("trophies")
}

// Persisted last-run state for the in-process job runner (M6.1). Restart
// safety: the runner compares each job's schedule against `last_run_at`
// instead of trusting an in-memory timer, so a redeploy mid-schedule can't
// cause a job to run twice, and a missed slot gets picked up on the next
// tick after boot. New table — no legacy Sequelize shape to match, so plain
// snake_case columns rather than a @map per field.
model JobRun {
  id          String   @id @default(uuid())
  job_name    String   @unique
  last_run_at DateTime
  status      String
  summary     String?  @db.Text
  error       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("job_runs")
}

// M9.7 — a member's public-visibility opt-out, honoured by both the bot
// (the /privacidade command) and the portal (portal/api/src/repositories/
// visibility.ts). One row per Discord member, keyed by their Discord id —
// deliberately NOT a `public_opt_out` column duplicated onto `ads`,
// `screenshots` and `trophyprofiles` (which is what
// portal/api/src/repositories/visibility.ts's scaffolding comments
// anticipated before this migration existed). Two reasons:
//
//   1. None of those three tables carries a real foreign key to a canonical
//      "user" today — `author_id`/`author_id`/`userId` are un-enforced free
//      -text Discord snowflakes, so there is no single place a member's
//      decision already lives.
//   2. A member's opt-out is a decision about *themselves*, not about any
//      one piece of content — it should cover everything they have ever
//      posted and everything they post after opting out, from one row,
//      without the bot needing to remember to copy a flag onto every new
//      ad/screenshot/profile at write time.
//
// Rows are created lazily by the opt-out/opt-in command — a member who has
// never touched either is simply absent from this table, which the read
// side treats as "opted in" (the default for the ~13k+ historical rows
// this migration does not and must not touch). See docs/plans/GLOBAL-PLAN.md
// M9.7 and docs/plans/03-portal.md decision 5.
model PrivacySetting {
  discordId    String   @id
  publicOptOut Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("privacy_settings")
}
