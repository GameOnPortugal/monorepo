{
    "name": "portal-api",
    "version": "0.1.0",
    "private": true,
    "module": "src/index.ts",
    "type": "module",
    "scripts": {
        "dev": "bun run --watch src/index.ts",
        "start": "bun run src/index.ts",
        "db:generate": "bunx prisma generate --schema=../../discord-bot/prisma/schema.prisma",
        "typecheck": "bun run db:generate && bunx tsc --noEmit",
        "test": "bun test"
    },
    "dependencies": {
        "hono": "^4.6.14"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "prisma": "6.6.0",
        "typescript": "^5"
    }
}
