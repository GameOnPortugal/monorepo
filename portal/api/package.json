{
  "name": "portal-api",
  "version": "0.5.0",
  "private": true,
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "db:generate": "bunx prisma generate --schema=../../discord-bot/prisma/schema.prisma",
    "typecheck": "bun run db:generate && bunx tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.8.0",
    "@prisma/client": "7.8.0",
    "hono": "^4.6.14",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "prisma": "7.8.0",
    "typescript": "^5"
  }
}
